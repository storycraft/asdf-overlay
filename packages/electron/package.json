{
  "name": "@asdf-overlay/electron",
  "version": "2.0.2",
  "description": "Asdf overlay Electron integration",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "type": "module",
  "author": "storycraft <me@pancake.sh>",
  "homepage": "https://github.com/storycraft/asdf-overlay#readme",
  "license": "MIT OR Apache-2.0",
  "bugs": {
    "url": "https://github.com/storycraft/asdf-overlay/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/storycraft/asdf-overlay"
  },
  "scripts": {
    "build:publish": "tsc",
    "build": "npm run build:publish"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    }
  },
  "files": [
    "lib/**/*"
  ],
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@asdf-overlay/core": "workspace:*",
    "electron": "^43.3.0"
  },
  "packageManager": "pnpm@11.17.0"
}
